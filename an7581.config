# ==============================================================================
# OpenWrt .config - Optimized for AN7581 (Nokia/Bell XG-040G-MD)
# 基于主线 Linux 6.18 / fw4 / APK 包管理器
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 目标芯片平台与设备 Profile
# ------------------------------------------------------------------------------
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
#CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_18=y
CONFIG_CCACHE=y

# ------------------------------------------------------------------------------
# 2. AN7581 硬件专有驱动、NPU 加速与温度监控 (吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_AIROHA_CPU_PM_DOMAIN=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_KERNEL_STRICT_DEVMEM is not set
CONFIG_PACKAGE_kmod-cpufreq-dt=y
CONFIG_PACKAGE_kmod-cpufreq-governor-performance=y
CONFIG_PACKAGE_kmod-cpufreq-governor-ondemand=y
CONFIG_PACKAGE_kmod-cpufreq-governor-conservative=y
#CONFIG_PACKAGE_collectd=y
#CONFIG_PACKAGE_collectd-mod-exec=y
#CONFIG_PACKAGE_collectd-mod-interface=y
#CONFIG_PACKAGE_collectd-mod-cpu=y
#CONFIG_PACKAGE_collectd-mod-sensors=y
#CONFIG_PACKAGE_iwinfo=y
#CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_kmod-airoha-npu=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-i2c-core=y
#CONFIG_PACKAGE_kmod-i2c-an7581=y
CONFIG_PACKAGE_kmod-thermal-an7581=y
#CONFIG_PACKAGE_kmod-hwmon-core=y
#CONFIG_PACKAGE_kmod-hwmon-temp=y
CONFIG_PACKAGE_kmod-thermal=y
#CONFIG_PACKAGE_kmod-hwmon-vid=y
#CONFIG_PACKAGE_lm-sensors is not set
#CONFIG_PACKAGE_luci-app-sensors=y
#CONFIG_PACKAGE_luci-i18n-sensors-zh-cn=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-phy-airoha=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_kmod-mdio-netlink=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_luci-app-cpu-status=y
CONFIG_PACKAGE_luci-i18n-cpu-status-zh-cn=y
CONFIG_PACKAGE_luci-app-temp-status=y
CONFIG_PACKAGE_luci-i18n-temp-status-zh-cn=y

# ------------------------------------------------------------------------------
# 3. 基础系统与包管理器 (APK)
# ------------------------------------------------------------------------------
CONFIG_DEFAULT_fitblk=y
CONFIG_DEFAULT_fstools=y
CONFIG_DEFAULT_mtd=y
CONFIG_DEFAULT_kmod-regulator-userspace-consumer=y
CONFIG_DEFAULT_kmod-usb-ledtrig-usbport=y
CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_dnsmasq-full=y
CONFIG_DEFAULT_firewall4=y
CONFIG_DEFAULT_dropbear=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
# CONFIG_USE_EXTERNAL_HOST_GOLANG is not set
CONFIG_GOLANG_BUILD_BOOTSTRAP=y
# CONFIG_GOLANG_EXTERNAL_BOOTSTRAP_ROOT is not set
#CONFIG_USE_EXTERNAL_HOST_RUST=y
# CONFIG_PACKAGE_rust is not set
# CONFIG_PACKAGE_rustc is not set
# CONFIG_PACKAGE_cargo is not set
CONFIG_USE_APK=y
CONFIG_PACKAGE_apk-mbedtls=y
# 或 CONFIG_PACKAGE_apk-openssl=y（二选一即可）
# 不要强制开 opkg 当主包管理
# CONFIG_PACKAGE_opkg is not set

# ------------------------------------------------------------------------------
# 4. 网络底层与透明代理加速 (nftables + TProxy) (吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_IPV6=y
CONFIG_PACKAGE_nftables=y
# CONFIG_PACKAGE_iptables-nft is not set
# CONFIG_PACKAGE_ip6tables-nft is not set
# CONFIG_PACKAGE_iptables is not set
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ------------------------------------------------------------------------------
# 5. USB 存储、磁盘格式与 SMART 健康监控 (配合 Samba4 / 吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_USB_SUPPORT=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
#CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
#CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ------------------------------------------------------------------------------
# 6. LuCI 界面与主题
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ------------------------------------------------------------------------------
# 7. 核心应用组件
# ------------------------------------------------------------------------------
# 7.1 科学上网: PassWall2 + Sing-Box（不要 SS-Rust，不编译 Rust）
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-passwall2=y
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

# ★ 正确选项名：关掉 SS-Rust（aarch64 默认会开，必须显式 is not set）
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set

# 不编 SSR / obfs（若你不用 SSR 节点）
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-server is not set
# CONFIG_PACKAGE_simple-obfs is not set

# CONFIG_SING_BOX_WITH_V2RAY_API is not set
# CONFIG_SING_BOX_WITH_EA_PROXY is not set
# CONFIG_SING_BOX_WITH_GVISOR is not set   # ★ 优先关，明显省内存
# CONFIG_SING_BOX_WITH_QUIC is not set
# CONFIG_SING_BOX_WITH_ACME is not set
# CONFIG_SING_BOX_WITH_V2RAY_API is not set
CONFIG_SING_BOX_WITH_CLASH_API=y
CONFIG_SING_BOX_WITH_DHCP=y
CONFIG_SING_BOX_WITH_REALITY_SERVER=y
CONFIG_SING_BOX_WITH_SHADOWSOCKS=y
CONFIG_SING_BOX_WITH_UTLS=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ★ 关掉所有 shadowsocks-rust 实体包
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssmanager is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssurl is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssservice is not set

# C 版 libev（包名不要写错）
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y
# CONFIG_PACKAGE_shadowsocks-libev-ss-server is not set

# 不要依赖“外部 Rust / 编 rust 包”
# CONFIG_USE_EXTERNAL_HOST_RUST is not set
# CONFIG_PACKAGE_rust is not set

# 7.2 Samba4 局域网共享
#CONFIG_PACKAGE_samba4-server=y
#CONFIG_PACKAGE_luci-app-samba4=y
#CONFIG_PACKAGE_autosamba=y
#CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# 7.3 WireGuard 组网
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_SING_BOX_WITH_WIREGUARD=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y

# 7.4 TurboACC 网络加速
#CONFIG_PACKAGE_luci-app-turboacc=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_FAST_CLASSIFIER=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE_CM=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
#CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# 7.5 UPnP / DDNS / WOL / VLMCSD ...
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
#CONFIG_PACKAGE_perl=y
#CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_omcproxy=y
CONFIG_PACKAGE_luci-app-omcproxy=y
CONFIG_PACKAGE_luci-i18n-omcproxy-zh-cn=y

# ------------------------------------------------------------------------------
# 8. 实用运维与测速工具 (吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_curl=y
#CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y

# ------------------------------------------------------------------------------
# 9. UBI & UBIFS 闪存文件系统支持
# ------------------------------------------------------------------------------
# 内核层级的 UBI / UBIFS 驱动支持
CONFIG_KERNEL_UBIFS_FS=y
CONFIG_KERNEL_UBIFS_FS_ADVANCED=y
#CONFIG_KERNEL_GZIP=y
#CONFIG_KERNEL_UBIFS_FS_LZO=y
CONFIG_KERNEL_UBIFS_FS_ZLIB=y
#CONFIG_KERNEL_UBIFS_FS_ZSTD=y

# 用户态 UBI 管理工具（用于终端下查看、格式化、挂载 UBI 卷）
CONFIG_PACKAGE_ubi-utils=y

# Target 镜像生成（生成 .ubi / .ubifs 格式的刷机固件）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y

# itb文件生成
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y

# 补齐 FIT 镜像校验工具
#CONFIG_PACKAGE_fit-check-image=y
CONFIG_PACKAGE_uboot-envtools=y

# ------------------------------------------------------------------------------
# 温度监控图表
# ------------------------------------------------------------------------------
# CONFIG_PACKAGE_collectd is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_libpcap is not set
#CONFIG_PACKAGE_kmod-mtd-rw=y
#CONFIG_PACKAGE_kmod-mtd=y
# CONFIG_PACKAGE_librrd1 is not set
# CONFIG_PACKAGE_collectd-mod-rrdtool is not set
# CONFIG_PACKAGE_collectd-mod-iwinfo is not set
# CONFIG_PACKAGE_collectd-mod-thermal is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_tcpdump is not set   # 不常用可关，需要时再装

# ==========================================================================
# AN7581 Hardware Crypto
# EIP93 + Linux Crypto API + IPsec + OpenSSL devcrypto
# ==========================================================================

CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_EIP93=y

# EIP93 OpenWrt package
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y

# Crypto API algorithms
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AUTHENC=y

# /dev/crypto
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_OPENSSL_ENGINE=y
CONFIG_PACKAGE_openssl-util=y

# IPsec / XFRM
CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_kmod-xfrm-core=y
CONFIG_PACKAGE_kmod-crypto-aead=y

# Crypto User API / AF_ALG
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# ==========================================================================
# NEON 试着打开
# ==========================================================================
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
